{
  "name": "@mjakl/pi-subagent",
  "version": "2.0.0",
  "description": "Serial, depth-limited Pi subagents with full context inheritance for local LLMs.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "bash-guardian.js",
    "runner.ts",
    "runner-cli.js",
